{
  "name": "piano-steps",
  "private": true,
  "type": "module",
  "description": "Learn a specific melody on the piano by watching which keys to press — fragment by fragment.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @piano-steps/server\" \"npm run dev -w @piano-steps/web\"",
    "dev:lan": "HOST=0.0.0.0 npm run dev",
    "build": "npm run build -w @piano-steps/web",
    "check:bundle": "node scripts/check-prod-bundle.mjs",
    "start": "npm run start -w @piano-steps/server",
    "start:lan": "HOST=0.0.0.0 npm run start -w @piano-steps/server",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit",
    "lesson:add": "tsx scripts/lesson-add.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
