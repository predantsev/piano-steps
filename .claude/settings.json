{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "startup-rules": {
      "source": {
        "source": "directory",
        "path": "../startup-rules"
      }
    }
  },
  "enabledPlugins": {
    "startups@startup-rules": true
  },
  "permissions": {
    "allow": [
      "Bash(docker compose down)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose up -d:*)",
      "Bash(docker ps)",
      "Bash(gh auth status)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status --short)",
      "Bash(git status)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)"
    ]
  }
}
