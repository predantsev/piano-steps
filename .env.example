# docker compose reads these from .env (copy this file to .env to change them)

# Host port of the app (this project owns the 9xxx block — startup-rules/PORTS.md)
PIANO_STEPS_PORT=9300
# 127.0.0.1 = this Mac only; 0.0.0.0 = also reachable from an iPad on the same Wi-Fi
PIANO_STEPS_BIND=127.0.0.1
# Postgres published on the host for inspection tools only
PIANO_STEPS_DB_PORT=9432
# Set to require `Authorization: Bearer <token>` on every write (recommended with BIND=0.0.0.0)
PIANO_STEPS_API_TOKEN=
# 1 = insert the public-domain demo lessons into an empty database
PIANO_STEPS_SEED_DEMO=1

# Native (non-Docker) dev: leave DATABASE_URL empty to use PGlite in apps/server/.data
# DATABASE_URL=postgres://piano:piano@127.0.0.1:9432/piano_steps
